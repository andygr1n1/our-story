{
    "name": "wedding-story",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev3": "vite --port 3333",
        "build": "bun run typecheck && vite build",
        "preview": "vite preview --port 9998",
        "lint:fix": "eslint ./src --quiet --fix",
        "tsc": "bun run typecheck && bun run lint:fix",
        "gen": "dotenv -- cross-var gql.tada generate schema VITE_CLIENT_ENDPOINT -o schema.graphql --header \"x-hasura-admin-secret: VITE_X_HASURA_ADMIN_SECRET\" && gql.tada generate output",
        "gendev": "dotenv -- cross-var gql.tada generate schema http://localhost:7008/v1/graphql/ -o schema.graphql --header \"x-hasura-admin-secret: %VITE_X_HASURA_ADMIN_SECRET%\" && gql.tada generate output",
        "typecheck": "node node_modules/@typescript/native/bin/tsc"
    },
    "dependencies": {
        "@tanstack/query-core": "^5.107.1",
        "@tanstack/react-query": "^5.107.1",
        "@tippyjs/react": "^4.2.6",
        "@vis.gl/react-google-maps": "^1.10.2",
        "bootstrap": "^5.3.9",
        "date-fns": "^4.4.0",
        "formik": "^2.4.9",
        "framer-motion": "^14.14.0",
        "gql.tada": "^1.11.5",
        "graphql": "^17.1.0",
        "graphql-request": "^7.4.0",
        "history": "^5.3.0",
        "i18next": "^27.1.3",
        "jwt-decode": "^4.0.0",
        "ky": "^2.2.0",
        "mobx": "^7.1.7",
        "mobx-react-lite": "^5.1.3",
        "mobx-state-tree": "^9.0.1",
        "react": "^19.3.1",
        "react-bootstrap": "^2.10.10",
        "react-day-picker": "^10.0.2",
        "react-dom": "^19.3.1",
        "react-hot-toast": "^2.6.1",
        "react-i18next": "^18.0.2",
        "react-icons": "^5.7.0",
        "react-intersection-observer": "^11.0.1",
        "react-router-dom": "^7.18.5",
        "react-scroll-parallax": "^3.5.0",
        "react-snowfall": "^2.4.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "^1.0.7",
        "universal-cookie": "^8.1.2",
        "vite-plugin-node-polyfills": "^0.28.0"
    },
    "devDependencies": {
        "@mertasan/tailwindcss-variables": "^2.7.0",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/eslint-plugin-query": "^5.107.1",
        "@tanstack/react-query-devtools": "^5.107.1",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^6.3.0",
        "clsx": "^2.0.0",
        "cross-var": "^1.1.0",
        "dotenv": "^18.0.10",
        "dotenv-cli": "^11.1.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-eslint-plugin": "^7.6.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "lodash-es": "^4.18.1",
        "postcss": "^8.5.33",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass": "^1.108.2",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "vite-plugin-babel-macros": "^1.0.6",
        "vite-plugin-inspect": "^12.1.0"
    }
}
